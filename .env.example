APP_URL=http://localhost:3000
DATA_DIR=./data
ADMIN_EMAILS=admin@example.com
# Only for local development. Magic links appear in the server terminal.
DEV_MAIL_LOG=true
# Required for real email delivery; never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nexene Ops <ops@example.com>
# Optional sample customers/projects; disabled by default.
SEED_DEMO=false

# Vercel: persistent SQLite-compatible Turso database (server-only secrets).
# Leave unset for local SQLite development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
